<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="add-user-id-to-orders" author="selawik">
        <addColumn tableName="products_in_cart">
            <column name="user_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="products_in_cart"
                baseColumnNames="user_id"
                constraintName="fk_products_in_cart_user"
                referencedTableName="users"
                referencedColumnNames="id"
                onDelete="RESTRICT"
                onUpdate="RESTRICT"/>

        <addNotNullConstraint
                tableName="products_in_cart"
                columnName="user_id"
                columnDataType="BIGINT"/>

        <rollback>
            <dropColumn tableName="products_in_cart" columnName="user_id"/>
            <dropForeignKeyConstraint constraintName="fk_products_in_cart_user" baseTableName="orders"/>
            <dropNotNullConstraint tableName="products_in_cart" columnName="user_id"/>
        </rollback>
    </changeSet>
</databaseChangeLog>